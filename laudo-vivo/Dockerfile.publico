# syntax=docker/dockerfile:1
# Imagem da DEMO PÚBLICA do Laudo Vivo (QR code no slide; a plateia usa sozinha), para o Cloud Run, só em CPU.
#
#   docker build -f Dockerfile.publico -t laudo-vivo:publico .
#   docker run --rm -p 127.0.0.1:8080:8080 laudo-vivo:publico          # http://127.0.0.1:8080
#
# O que muda em relação ao Dockerfile da demo (o uso normal não muda): LAUDO_DEMO_PUBLICA=1 (laudo.api.publica).
# - Cada visitante (cookie) ganha a sua cópia da fiscalização do DEMO-0001, já aberta no passo 1, numa pasta do
#   disco temporário da instância (/tmp, apagada depois de 2 h parada); limites de cópias, turnos, falas e arquivos.
# - LLM `publico`: o passo do roteiro ("Executar passo") sai da gravação do qwen3.5:4b (custo zero); o texto livre e a
#   voz vão ao LLM ao vivo da cadeia (Gemini no Vertex AI, `LAUDO_LLM_LIVRE`, padrão `vertex`); sem ele, ao plano
#   mínimo e às falas por template, sem erro.
# - Vídeo, satélite, GPS e leitura do DANFE: os presets do caso, com o resultado em cache. O build roda o roteiro
#   inteiro numa cópia (`python -m laudo.api.publica --preparar`: 19 passos, SELADO, 0 fora da gravação) e guarda a
#   contagem do vídeo do caso (o YOLOX não roda de novo para ele). Do aparelho: foto, vídeo de até 20 s (YOLOX na CPU,
#   até ~1 min) e o XML da NF-e.
# - Voz ao vivo na CPU: faster-whisper int8, 4 threads, com o modelo baixado no build (ASR_MODELO). Medido em
#   24/10/2026 num Ryzen 9 9950X3D (4 threads, beam 1, VAD), 6 s de fala pt-BR: small 0,93 s, medium 2,56 s; nesta
#   imagem, com `docker run --cpus 4`, o medium levou 1,9 a 2,0 s (o critério era < 4 s; nas vCPUs do Cloud Run
#   espere até ~2x isso). Padrão: medium; `--build-arg ASR_MODELO=Systran/faster-whisper-small` deixa a fala ~2,7x
#   mais rápida e a imagem ~1 GB menor.
# - Porta pela variável PORT do Cloud Run (padrão 8080); saúde em /api/saude; sem rota de administração (documentação
#   da API e aquecimento desligados), sem CORS, POST de outro site recusado.
FROM mambaorg/micromamba:2.9.0-debian12-slim

# ativa o ambiente base nos RUN abaixo (convenção da imagem mambaorg/micromamba)
ARG MAMBA_DOCKERFILE_ACTIVATE=1

COPY --chown=$MAMBA_USER:$MAMBA_USER environment.yml /tmp/environment.yml
RUN micromamba install --yes --name base --file /tmp/environment.yml \
    && micromamba clean --all --yes

# Voz ao vivo: faster-whisper e ctranslate2 só existem no PyPI. Aqui é obrigatório (o build para sem eles). Versões
# fixas, as do ambiente testado, com o sha256 publicado no pypi.org: um espelho do PyPI (`--build-arg
# PIP_INDEX_URL=...`, para rede que bloqueia files.pythonhosted.org) não consegue trocar o arquivo. As dependências
# deles (av, onnxruntime, tokenizers, huggingface_hub, numpy, pyyaml) já vêm do conda-forge.
ARG PIP_INDEX_URL=
RUN printf '%s\n' \
      'faster-whisper==1.2.1 --hash=sha256:79a66ad50688c0b794dd501dc340a736992a6342f7f95e5811be60b5224a26a7' \
      'ctranslate2==4.8.1 --hash=sha256:dacc408f716ebc73b3b3c6ddd937700e776c4c68b6d9c81862990150ff0f6af6' \
      > /tmp/voz.txt \
    && python -m pip install --no-cache-dir --no-deps --require-hashes --retries 2 --timeout 60 \
         ${PIP_INDEX_URL:+--index-url "$PIP_INDEX_URL"} -r /tmp/voz.txt \
    && python -c "import ctranslate2, faster_whisper; print('voz:', faster_whisper.__version__, ctranslate2.__version__)"

USER root
RUN mkdir -p /app && chown "$MAMBA_USER:$MAMBA_USER" /app
USER $MAMBA_USER
WORKDIR /app

ENV PYTHONPATH=/app/src \
    PYTHONUTF8=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/app/modelos/hf

# Whisper no cache do Hugging Face da imagem (o código só lê do cache: laudo.speech.asr.localizar_modelo)
ARG ASR_MODELO=Systran/faster-whisper-medium
RUN python -c "import sys; from huggingface_hub import snapshot_download as s; print(s(sys.argv[1]))" "$ASR_MODELO"

COPY --chown=$MAMBA_USER:$MAMBA_USER . /app
# Ativos da demo (vídeo, satélite) e o yolox_m (release oficial, sha256 conferido); depois o roteiro inteiro numa
# cópia da demo pública, que confere a gravação e deixa a contagem do vídeo do caso em cache. O sal da instalação
# criado nesse ensaio sai da imagem: cada instância cria o seu na subida.
RUN python scripts/preparar_demo.py \
    && python -m laudo.api.publica --preparar \
    && rm -rf dados_locais/config dados_locais/api /tmp/laudo-demo-*

# TZ: os horários do laudo (abertura, rascunho, assinatura, selo) no fuso da demo, não em UTC
ENV LAUDO_DEMO_PUBLICA=1 \
    LAUDO_ASR_MODELO=$ASR_MODELO \
    HF_HUB_OFFLINE=1 \
    LAUDO_DEMO_DIR=/tmp/laudo-demo-publica \
    TZ=America/Sao_Paulo \
    PORT=8080

EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=6 \
    CMD ["/opt/conda/bin/python", "-c", \
         "import os, urllib.request as u; u.urlopen('http://127.0.0.1:%s/api/saude' % os.environ.get('PORT', '8080'))"]

# --host 0.0.0.0 dentro do contêiner; a porta vem de PORT. --aquecer carrega o Whisper na subida (a 1ª fala não
# espera a carga).
CMD ["python", "-m", "laudo.api", "--host", "0.0.0.0", "--caso", "DEMO-0001", "--ferramentas", "reais", \
     "--perfil", "campo", "--llm", "publico", "--asr", "cpu", "--aquecer"]
